<Page x:Class="RasHod.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RasHod.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainPage" Loaded="Page_Loaded">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>
        <WrapPanel Grid.ColumnSpan="2" Grid.Column="0" Grid.Row="0">
            <TextBlock Text="Поиск:" Width="50" FontSize="14"/>
            <TextBox x:Name="TBSearch" Width="200" TextChanged="TBSearch_TextChanged"/>
            <TextBlock Text="Категория:" Width="70" FontSize="14"/>
            <ComboBox x:Name="CBCategory" Width="200" SelectionChanged="CBCategory_SelectionChanged" DisplayMemberPath="name" SelectedValuePath="id"/>
            <TextBlock Text="Диапазон дат c " Width="auto" FontSize="14"/>
            <DatePicker x:Name="DT1" SelectedDateChanged="DT1_SelectedDateChanged"/>
            <TextBlock Text=" по " FontSize="14"/>
            <DatePicker x:Name="DT2" SelectedDateChanged="DT2_SelectedDateChanged"/>
            <CheckBox x:Name="CHBCurrMonth" Content="Текущий месяц" Checked="CHBCurrMonth_Checked" Unchecked="CHBCurrMonth_Checked" FontSize="14" VerticalAlignment="Center"/>
        </WrapPanel>
        <DataGrid x:Name="DGRashod" Grid.Row="1" Grid.Column="0" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="DGRashod_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="1.5*"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding Amount}" Width="1*"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding Date}" Width="1*"/>
                <DataGridTextColumn Header="Категория" Binding="{Binding CategoryName}" Width="1*"/>
                <DataGridTextColumn Header="Комментарий" Binding="{Binding Comment}" Width="2*"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Orientation="Horizontal" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,10,0,0">
            <TextBlock Text="Количество: " FontWeight="Bold"/>
            <TextBlock x:Name="TBCount" Text="0" Margin="0,0,20,0"/>
            <TextBlock Text="Сумма: " FontWeight="Bold"/>
            <TextBlock x:Name="TBSum" Text="0.00" Foreground="Green"/>
            <Button Content="Добавить" x:Name="BTAdd" VerticalAlignment="Center" Margin="5,0,5,0" Click="BTAdd_Click"/>
            <Button Content="Редактировать" x:Name="BTEdit" VerticalAlignment="Center" Margin="5,0,5,0" Click="BTEdit_Click"/>
            <Button Content="Удалить" x:Name="BTDelete" VerticalAlignment="Center" Margin="5,0,5,0" Click="BTDelete_Click"/>
        </StackPanel>
    </Grid>
</Page>
