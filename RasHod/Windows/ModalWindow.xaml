<Window x:Class="RasHod.Windows.ModalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RasHod.Windows"
        mc:Ignorable="d"
        Title="ModalWindow" Height="450" Width="800" WindowStartupLocation="CenterOwner">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Название *:" Grid.Row="0" VerticalAlignment="Center" Margin="3"/>
        <TextBox Text="{Binding Title}" Grid.Row="0" Grid.Column="1" Height="23" Margin="3"/>

        <TextBlock Text="Сумма *:" Grid.Row="1" VerticalAlignment="Center" Margin="3"/>
        <TextBox x:Name="tbAmount" Text="{Binding Amount}" Grid.Row="1" Grid.Column="1" Height="23" Margin="3"/>

        <TextBlock Text="Дата *:" Grid.Row="2" VerticalAlignment="Center" Margin="3"/>
        <DatePicker SelectedDate="{Binding Date}" Grid.Row="2" Grid.Column="1" Height="23" Margin="3"/>

        <TextBlock Text="Категория *:" Grid.Row="3" VerticalAlignment="Center" Margin="3"/>
        <ComboBox x:Name="cbCategory" SelectedValue="{Binding CategoryId}" DisplayMemberPath="name" SelectedValuePath="id" Grid.Row="3" Grid.Column="1" Height="23" Margin="3"/>

        <TextBlock Text="Комментарий:" Grid.Row="4" Margin="3"/>
        <TextBox Text="{Binding Comment}" Grid.Row="4" Grid.Column="1" Margin="3" TextWrapping="Wrap" AcceptsReturn="True"/>

        <StackPanel Orientation="Horizontal" Grid.Row="5" Grid.Column="1" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Сохранить" Width="85" Margin="0,0,10,0" Click="BtnSave_Click"/>
            <Button Content="Отмена" Width="85" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>